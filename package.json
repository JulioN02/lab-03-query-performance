    "exp:baseline": "node --experimental-strip-types src/exp-01-baseline.ts",
    "exp:explain": "node --experimental-strip-types src/exp-02-explain.ts",
    "exp:index": "node --experimental-strip-types src/exp-03-index.ts",
    "exp:covering": "node --experimental-strip-types src/exp-04-covering.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
