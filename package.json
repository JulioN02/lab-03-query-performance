  "description": "Laboratorio de rendimiento de consultas PostgreSQL - EXPLAIN ANALYZE, índices B-tree, compuestos y cubrientes",
  "type": "module",
  "scripts": {
    "db:setup": "node --experimental-strip-types src/setup.ts --fresh",
